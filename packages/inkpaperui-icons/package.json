{
  "name": "inkpaperui-icons",
  "version": "0.1.0",
  "description": "24px line icons for inkpaperUI, with the same names as gamifiedui-icons. Tailwind v4 utilities or plain CSS.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/inkpaperUI.git",
    "directory": "packages/inkpaperui-icons"
  },
  "author": "Carson Hung (https://github.com/carsonhung)",
  "type": "module",
  "style": "./src/index.css",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./icons.json": "./icons.json",
    "./svg/*": "./svg/*"
  },
  "files": [
    "src",
    "svg",
    "icons.json",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "icons",
    "line-art",
    "tailwindcss",
    "svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  }
}
